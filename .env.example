# ==============================================================================
# RevenueGuard Production Environment Variables (.env.example)
# Copy to .env and configure values before starting the application in production.
# NEVER commit the actual .env file or production secrets to source control.
# ==============================================================================

# Application Environment Mode: development | testing | production
ENVIRONMENT=production

# Debug Mode: must be false in production (enforced automatically in code)
DEBUG=false

# Interactive API Documentation (/api/docs and /api/redoc)
DOCS_ENABLED=false

# Database Connection URL:
# For SQLite (Self-contained / single-instance):
DATABASE_URL=sqlite:///./revenueguard.db
# For PostgreSQL (Multi-instance / enterprise production):
# DATABASE_URL=postgresql://rg_admin:your_secure_password_here@postgres-host:5432/revenueguard_prod

# Cryptographically Secure Application Secret Key (minimum 32 characters)
SECRET_KEY=change-this-to-a-cryptographically-random-32-character-secret-key

# Permitted CORS Origins (comma-separated list of allowed domains)
ALLOWED_ORIGINS=https://revenueguard.yourcompany.com,https://dashboard.yourcompany.com

# Server Bind Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

